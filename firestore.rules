rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.blocked == false;
      allow read: if isSelf(uid) || isAdmin();
      allow update: if (isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.blocked == resource.data.blocked)
        || isAdmin();
      allow delete: if isAdmin();
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.mediaUrl is string
        && request.resource.data.storagePath is string
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(25, 'h');
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /chats/{chatId} {
      function member() { return signedIn() && request.auth.uid in resource.data.members; }
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      allow read: if member() || isAdmin();
      allow update: if (member()
        && request.resource.data.members == resource.data.members)
        || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function chatMember() {
          return signedIn() &&
            exists(/databases/$(database)/documents/chats/$(chatId)) &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read: if chatMember() || isAdmin();
        allow create: if chatMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if isAdmin();
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string;
      allow read, update, delete: if isAdmin();
    }
  }
}